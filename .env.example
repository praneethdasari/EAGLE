# EAGLE Environment Variables Template
# Copy this file to .env and configure your desired settings.
# NEVER commit your actual .env file to Git!

# General Settings
EAGLE_ENV=development
EAGLE_LOG_LEVEL=INFO

# AI Provider Credentials (Optional - cloud providers only used if configured)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Local Model Settings (e.g., Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Speech Recognition & Voice Synthesis Settings
EAGLE_STT_MODEL=base
EAGLE_TTS_VOICE=default
EAGLE_WAKE_WORD_ENABLED=false
